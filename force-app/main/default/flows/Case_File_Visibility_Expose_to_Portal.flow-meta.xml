<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_case_file_to_Update</name>
        <label>Assign case file to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CaseFileCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ContentDocumentData</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Case_File_Links</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Visibility_to_AllUsers</name>
        <label>Set Visibility to AllUsers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ContentDocumentData.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Case_File_Links.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ContentDocumentData.Visibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_case_file_to_Update</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_This_A_Case_Upload</name>
        <label>Is This A Case Upload?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Case_Upload</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_File_Links</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_This_The_Uploaded_File_Internal</name>
        <label>Is This The Uploaded File + Internal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Case_File_Links</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nope</defaultConnectorLabel>
        <rules>
            <name>Yes_it_is</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Case_File_Links.ContentDocumentId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ContentDocumentId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Case_File_Links.Visibility</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>InternalUsers</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Visibility_to_AllUsers</targetReference>
            </connector>
            <label>Yes it is</label>
        </rules>
    </decisions>
    <description>Automatically sets ContentDocumentLink visibility to AllUsers for files uploaded to Case records so they are visible in the member portal.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Case_Upload</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.FirstPublishLocationId}, &quot;500&quot;)</expression>
    </formulas>
    <interviewLabel>Case File Visibility - Expose to Portal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case File Visibility - Expose to Portal</label>
    <loops>
        <name>Loop_Case_File_Links</name>
        <label>Loop Case File Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Case_File_Links</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_This_The_Uploaded_File_Internal</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Current_Link</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_File_Links</name>
        <label>Get Case File Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Case_File_Links</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FirstPublishLocationId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Current_Link</name>
        <label>Update Current Link</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>CaseFileCollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedById</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ContentVersion</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Update_File_Visibility</name>
            <connector>
                <targetReference>Is_This_A_Case_Upload</targetReference>
            </connector>
            <label>Update File Visibility</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>CaseFileCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
    <variables>
        <name>ContentDocumentData</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
</Flow>
